# Copy this file to .env and fill in real values once we set up accounts together
GEMINI_API_KEY=
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
# Set to true when deployed over HTTPS (keeps the sign-in cookie off plain HTTP)
COOKIE_SECURE=
# Who can sign up as a teacher: anyone who knows this. Use a long random value; empty = no teacher sign-up
TEACHER_SIGNUP_CODE=
